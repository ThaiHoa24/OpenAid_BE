generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  USER
  ADMIN
}

enum OrganizationRole {
  MEMBER
  ORGANIZER
}

enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum VolunteerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DonationStatus {
  PENDING
  RECEIVED
  REJECTED
  IN_BATCH
  DISTRIBUTED
  CANCELLED
}

enum BatchStatus {
  DRAFT
  READY
  ASSIGNED
  DISTRIBUTED
}

enum TripStatus {
  SCHEDULED
  PREPARING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum TripVolunteerRole {
  LEADER
  MEMBER
}

enum DistributionPointStatus {
  PENDING
  ARRIVED
  DISTRIBUTED
  SKIPPED
}

enum EvidenceReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransparencyEntityType {
  ORGANIZATION
  EVENT
  VOLUNTEER_APPLICATION
  DONATION
  INVENTORY
  BATCH
  TRIP
  DISTRIBUTION_POINT
  DISTRIBUTION_RECORD
  EVIDENCE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  avatarUrl    String?
  systemRole   SystemRole @default(USER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships           OrganizationMember[]
  donations             Donation[]
  volunteerApplications VolunteerApplication[]
  distributionRecords   DistributionRecord[]
  uploadedEvidence      Evidence[]             @relation("EvidenceUploader")
  reviewedEvidence      Evidence[]             @relation("EvidenceReviewer")
  logs                  TransparencyLog[]

  @@map("users")
}

model Organization {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  email       String
  phoneNumber String?
  address     String?
  status      OrgStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members OrganizationMember[]
  events  Event[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model Event {
  id             String      @id @default(uuid())
  organizationId String
  title          String
  description    String?
  location       String
  contactName    String
  contactPhone   String?
  startDate      DateTime
  endDate        DateTime?
  status         EventStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  volunteerRoles        VolunteerRole[]
  volunteerApplications VolunteerApplication[]
  donationNeeds         DonationNeed[]
  donations             Donation[]
  inventory             Inventory[]
  batches               Batch[]
  trips                 Trip[]

  @@index([organizationId, status])
  @@index([status, startDate])
  @@map("events")
}

model VolunteerRole {
  id          String   @id @default(uuid())
  eventId     String
  name        String
  description String?
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  applications VolunteerApplication[]

  @@unique([id, eventId])
  @@unique([eventId, name])
  @@map("volunteer_roles")
}

model VolunteerApplication {
  id              String                     @id @default(uuid())
  eventId         String
  userId          String
  volunteerRoleId String
  status          VolunteerApplicationStatus @default(PENDING)
  notes           String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  event           Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  volunteerRole   VolunteerRole        @relation(fields: [volunteerRoleId, eventId], references: [id, eventId], onDelete: Restrict)
  attendance      VolunteerAttendance?
  tripAssignments TripVolunteer[]

  @@unique([eventId, userId])
  @@unique([id, eventId])
  @@index([userId, status])
  @@map("volunteer_applications")
}

model VolunteerAttendance {
  id            String    @id @default(uuid())
  applicationId String    @unique
  checkedInAt   DateTime
  checkedOutAt  DateTime?

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@map("volunteer_attendance")
}

// Standard catalogs avoid treating variations of a label as different goods/units.
model ItemType {
  id       String @id @default(uuid())
  code     String @unique
  name     String
  category String

  needs     DonationNeed[]
  inventory Inventory[]

  @@map("item_types")
}

model Unit {
  id   String @id @default(uuid())
  code String @unique
  name String

  needs     DonationNeed[]
  inventory Inventory[]

  @@map("units")
}

model DonationNeed {
  id             String  @id @default(uuid())
  eventId        String
  itemTypeId     String
  unitId         String
  targetQuantity Decimal @db.Decimal(14, 3)
  notes          String?

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  itemType  ItemType   @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  donations Donation[]

  @@unique([eventId, itemTypeId, unitId])
  @@unique([id, eventId, itemTypeId, unitId])
  @@map("donation_needs")
}

model Donation {
  id              String         @id @default(uuid())
  trackingId      String         @unique
  eventId         String
  donationNeedId  String
  itemTypeId      String
  unitId          String
  donorId         String
  // A single nullable FK implements the MVP rule: one Donation, at most one Batch.
  batchId         String?
  quantity        Decimal        @db.Decimal(14, 3)
  photoUrl        String?
  status          DonationStatus @default(PENDING)
  receivedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  donor        User         @relation(fields: [donorId], references: [id], onDelete: Restrict)
  donationNeed DonationNeed @relation(fields: [donationNeedId, eventId, itemTypeId, unitId], references: [id, eventId, itemTypeId, unitId], onDelete: Restrict)
  batch        Batch?       @relation(fields: [batchId, eventId, itemTypeId, unitId], references: [id, eventId, itemTypeId, unitId], onDelete: Restrict)

  @@index([donorId, createdAt])
  @@index([eventId, status])
  @@index([batchId])
  @@map("donations")
}

// Stock is earmarked for an Event. Organization stock is aggregated through Event.
model Inventory {
  id                  String   @id @default(uuid())
  eventId             String
  itemTypeId          String
  unitId              String
  receivedQuantity    Decimal  @default(0) @db.Decimal(14, 3)
  availableQuantity   Decimal  @default(0) @db.Decimal(14, 3)
  reservedQuantity    Decimal  @default(0) @db.Decimal(14, 3)
  distributedQuantity Decimal  @default(0) @db.Decimal(14, 3)
  lostQuantity        Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt           DateTime @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  itemType ItemType @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  batches  Batch[]

  @@unique([eventId, itemTypeId, unitId])
  @@unique([id, eventId, itemTypeId, unitId])
  @@map("inventories")
}

model Batch {
  id                 String      @id @default(uuid())
  batchCode          String      @unique
  eventId            String
  inventoryId        String
  itemTypeId         String
  unitId             String
  quantity           Decimal     @db.Decimal(14, 3)
  returnedQuantity   Decimal     @default(0) @db.Decimal(14, 3)
  lostQuantity       Decimal     @default(0) @db.Decimal(14, 3)
  reconciliationNote String?
  status             BatchStatus @default(DRAFT)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  inventory   Inventory   @relation(fields: [inventoryId, eventId, itemTypeId, unitId], references: [id, eventId, itemTypeId, unitId], onDelete: Restrict)
  donations   Donation[]
  assignments TripBatch[]

  @@unique([id, eventId])
  @@unique([id, eventId, itemTypeId, unitId])
  @@index([eventId, status])
  @@map("batches")
}

model Trip {
  id             String     @id @default(uuid())
  tripCode       String     @unique
  eventId        String
  departurePoint String
  departureDate  DateTime
  vehicle        String?
  status         TripStatus @default(SCHEDULED)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  event      Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  volunteers TripVolunteer[]
  batches    TripBatch[]
  points     DistributionPoint[]
  records    DistributionRecord[]
  evidence   Evidence[]

  @@unique([id, eventId])
  @@index([eventId, status])
  @@map("trips")
}

model TripVolunteer {
  id            String            @id @default(uuid())
  tripId        String
  eventId       String
  applicationId String
  role          TripVolunteerRole @default(MEMBER)
  assignedAt    DateTime          @default(now())

  trip        Trip                 @relation(fields: [tripId, eventId], references: [id, eventId], onDelete: Restrict)
  application VolunteerApplication @relation(fields: [applicationId, eventId], references: [id, eventId], onDelete: Restrict)

  @@unique([tripId, applicationId])
  @@map("trip_volunteers")
}

model TripBatch {
  id           String    @id @default(uuid())
  tripId       String
  batchId      String
  eventId      String
  assignedAt   DateTime  @default(now())
  // Preserve cancelled-trip history. A partial unique index protects active assignments.
  unassignedAt DateTime?

  trip    Trip                 @relation(fields: [tripId, eventId], references: [id, eventId], onDelete: Restrict)
  batch   Batch                @relation(fields: [batchId, eventId], references: [id, eventId], onDelete: Restrict)
  records DistributionRecord[]

  @@unique([tripId, batchId])
  @@unique([id, tripId])
  @@map("trip_batches")
}

model DistributionPoint {
  id            String                  @id @default(uuid())
  tripId        String
  position      Int
  name          String
  location      String
  mapUrl        String?
  status        DistributionPointStatus @default(PENDING)
  arrivedAt     DateTime?
  distributedAt DateTime?
  skippedReason String?

  trip     Trip                 @relation(fields: [tripId], references: [id], onDelete: Restrict)
  records  DistributionRecord[]
  evidence Evidence[]

  @@unique([tripId, position])
  @@unique([id, tripId])
  @@map("distribution_points")
}

model DistributionRecord {
  id                  String   @id @default(uuid())
  tripId              String
  tripBatchId         String
  distributionPointId String
  distributedQuantity Decimal  @db.Decimal(14, 3)
  beneficiaryCount    Int      @default(0)
  notes               String?
  confirmedById       String
  confirmedAt         DateTime @default(now())

  trip        Trip              @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripBatch   TripBatch         @relation(fields: [tripBatchId, tripId], references: [id, tripId], onDelete: Restrict)
  point       DistributionPoint @relation(fields: [distributionPointId, tripId], references: [id, tripId], onDelete: Restrict)
  confirmedBy User              @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  evidence    Evidence[]

  @@unique([tripBatchId, distributionPointId])
  @@unique([id, tripId, distributionPointId])
  @@map("distribution_records")
}

model Evidence {
  id                   String               @id @default(uuid())
  tripId               String
  distributionPointId  String
  distributionRecordId String?
  uploadedById         String
  imageUrl             String
  mimeType             String
  sizeBytes            Int
  caption              String?
  privacyConfirmed     Boolean              @default(false)
  reviewStatus         EvidenceReviewStatus @default(PENDING)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  uploadedAt           DateTime             @default(now())

  trip       Trip                @relation(fields: [tripId], references: [id], onDelete: Restrict)
  point      DistributionPoint   @relation(fields: [distributionPointId, tripId], references: [id, tripId], onDelete: Restrict)
  record     DistributionRecord? @relation(fields: [distributionRecordId, tripId, distributionPointId], references: [id, tripId, distributionPointId], onDelete: Restrict)
  uploadedBy User                @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy User?               @relation("EvidenceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  logs       TransparencyLog[]

  @@index([tripId, reviewStatus])
  @@map("evidence")
}

model TransparencyLog {
  id         String                 @id @default(uuid())
  action     String
  entityType TransparencyEntityType
  entityId   String
  actorId    String
  oldStatus  String?
  newStatus  String?
  evidenceId String?
  details    Json?
  createdAt  DateTime               @default(now())

  actor    User      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  evidence Evidence? @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@map("transparency_logs")
}
