PORT=3001
NODE_ENV=development
# Existing local PostgreSQL database (replace the password; URL-encode special characters)
DATABASE_URL="postgresql://postgres:replace-with-your-postgres-password@localhost:5432/openaid?schema=public"

# Authentication
JWT_SECRET="replace-with-a-random-development-secret"
JWT_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:3000"

# Optional Docker Compose database; separate from the existing local openaid DB
POSTGRES_USER=openaid
POSTGRES_PASSWORD=openaid_dev_password
POSTGRES_DB=openaid_db
DB_PORT=5433
