PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://openaid:openaid_dev_password@localhost:5433/openaid_db?schema=public"

# Authentication
JWT_SECRET="replace-with-a-random-development-secret"
JWT_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:3000"

# Optional Docker Compose overrides
POSTGRES_USER=openaid
POSTGRES_PASSWORD=openaid_dev_password
POSTGRES_DB=openaid_db
DB_PORT=5433
